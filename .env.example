# Server settings for a Vercel deployment. Copy to .env.local for the migration script.
# Never add VITE_ prefixes or a visitor's TypeSafe API key.
DATABASE_URL=
APP_ORIGIN=https://your-project.vercel.app
SESSION_SECRET=
CRON_SECRET=

# At least 24 characters. Required for production admin login; never use a VITE_ prefix.
ADMIN_PASSWORD=
